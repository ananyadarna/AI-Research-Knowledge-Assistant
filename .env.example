# Application Configuration
HOST=127.0.0.1
PORT=8000

# Storage Directories
DATABASE_URL=sqlite:///./data/assistant.db
VECTOR_DB_DIR=./data/vector_db
UPLOAD_DIR=./data/raw_documents

# AI LLM Provider Configuration (options: openai, gemini)
LLM_PROVIDER=openai

# OpenAI Settings (if using openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-4o-mini

# Google Gemini Settings (if using gemini)
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL_NAME=gemini-1.5-flash

# Embedding configuration (options: local, openai, gemini)
EMBEDDING_PROVIDER=local
# OpenAI embedding model (if embedding_provider is openai): text-embedding-3-small
# Gemini embedding model (if embedding_provider is gemini): models/embedding-001
